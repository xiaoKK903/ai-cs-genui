# LLM 提供方。mock（默认）= 确定性规则适配器，不联网、不花钱，整条链路可离线跑通。
# anthropic = 调用真实模型，需要下面的 ANTHROPIC_API_KEY。
LLM_PROVIDER=mock

# 仅 LLM_PROVIDER=anthropic 时需要
ANTHROPIC_API_KEY=
# 可选，默认 claude-opus-5
LLM_MODEL=
# 可选，off = 关闭 adaptive thinking（跑对照实验用，看思考对工具选择准确率的净影响）
LLM_THINKING=on

# 一键降级总开关：on = 整条链路只出文本、不渲染任何组件。
# 生产环境用它做应急回滚（不用走发布流程），演示环境用它验证降级链路。
FORCE_TEXT_ONLY=off

# 演示节奏控制（仅 mock 生效），调成 0 可以让自测和评测跑得更快
MOCK_STREAM_DELAY_MS=18
MOCK_TOOL_DELAY_MS=260

# 审计落盘开关。日志写到 .audit/turns.jsonl（append-only），失败不影响对话。
AUDIT_LOG=on
