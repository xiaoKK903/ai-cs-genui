# LLM 提供方。三个可选值，认不出来的值会直接报错（不静默退回 mock —— 拼错的
# provider 名跑出一个和真模型无关的漂亮数字，是最难发现的一类错）。
#   mock（默认）= 确定性规则适配器，不联网、不花钱，整条链路可离线跑通
#   anthropic   = 调用真实模型，需要下面的 ANTHROPIC_API_KEY
#   ollama      = 调用本地模型，需要 ollama serve 且已 pull 模型
LLM_PROVIDER=mock

# ---- anthropic ----
# 仅 LLM_PROVIDER=anthropic 时需要
ANTHROPIC_API_KEY=
# 可选，off = 关闭 adaptive thinking（跑对照实验用，看思考对工具选择准确率的净影响）
LLM_THINKING=on

# ---- ollama ----
# 服务地址。默认 http://127.0.0.1:11434
OLLAMA_BASE_URL=
# 单次请求超时。默认 25000ms。
#
# ⚠️ 它和下面的 LLM_TIMEOUT_MS 是**嵌套的两道**，必须满足
#    OLLAMA_TIMEOUT_MS < LLM_TIMEOUT_MS。
#    内层（这个）先到，用户才会看到「模型还在加载权重 / 把超时调大一点」这种
#    能照着做的提示；外层先到，只能拿到一句「llm.decide 超过 N ms 未返回」。
#    selftest 里有一条专门比这两个当前生效值的断言守着这个顺序。
#
#    本地模型跑得动，两个都要一起调大。实测一组（Xeon E5-2683 v3 纯 CPU 跑 3B，
#    光是把 system prompt + 四个工具定义读进去就要十几秒）：
#      OLLAMA_TIMEOUT_MS=150000
#      LLM_TIMEOUT_MS=180000
OLLAMA_TIMEOUT_MS=

# 网关侧单次模型决策的超时（外面那道），默认 30000ms。
# 它必须**大于**上面的 OLLAMA_TIMEOUT_MS —— 理由写在那一条里。
LLM_TIMEOUT_MS=

# 模型名。**两个 provider 共用这一个变量**，所以切换时记得一起改：
#   anthropic → 默认 claude-opus-5
#   ollama    → 默认 qwen2.5:3b
# 不设就用各自的默认值。
LLM_MODEL=

# 一键降级总开关：on = 整条链路只出文本、不渲染任何组件。
# 生产环境用它做应急回滚（不用走发布流程），演示环境用它验证降级链路。
FORCE_TEXT_ONLY=off

# 演示节奏控制（仅 mock 生效），调成 0 可以让自测和评测跑得更快
MOCK_STREAM_DELAY_MS=18
MOCK_TOOL_DELAY_MS=260

# 审计落盘开关。日志写到 .audit/turns.jsonl（append-only），失败不影响对话。
AUDIT_LOG=on

# ---- 可观测性出境（详见 README §7）----
# 不配 ENDPOINT 就完全不上报 —— 接外部观测后端要先想清楚数据出境的问题，
# 所以它必须是显式动作，不能因为装了个依赖就默认开着。
OBSERVABILITY_OTLP_ENDPOINT=
# 鉴权头，比如 Langfuse 的 Basic / Bearer
OBSERVABILITY_OTLP_AUTH=
# 采样率 0~1。降级 / 被闸拒 / 有失败步骤的轮次**不受它影响**，永远上报
OBSERVABILITY_SAMPLE_RATE=1
# 用户/会话标识的哈希盐。**生产必须设** —— 用户 ID 取值空间很小，
# 固定盐的哈希在拿到 ID 全集之后是可以枚举出来的
OBSERVABILITY_SALT=
# 打开就把 step.detail 一起上报，而出错信息经常原样引用用户输入 —— 等于开了个后门
OBSERVABILITY_INCLUDE_DETAIL=off
# 队列上限与单次超时
OBSERVABILITY_MAX_QUEUE=256
OBSERVABILITY_TIMEOUT_MS=2000
OBSERVABILITY_SERVICE_NAME=
