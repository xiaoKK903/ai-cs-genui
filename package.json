{
  "name": "ai-cs-genui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 客服 Generative UI —— Tool Calling + 组件白名单 + SSE 多事件流",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts",
    "check:persist": "tsx scripts/persistence-check.ts write && tsx scripts/persistence-check.ts verify",
    "eval": "tsx eval/run.ts",
    "eval:validate": "tsx eval/validate.ts",
    "eval:ingest": "tsx eval/ingest.ts",
    "eval:trend": "tsx eval/trend.ts",
    "regress": "tsx eval/validate.ts && tsx eval/run.ts --strict",
    "bench": "tsx scripts/bench.ts",
    "mcp": "tsx mcp/main.ts",
    "check": "npm run typecheck && npm run selftest && npm run check:persist && npm run regress"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
